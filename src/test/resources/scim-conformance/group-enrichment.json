{
  "name": "group-enrichment",
  "steps": [
    {
      "note": "an exported role's wire-group render carries the read-only access projection: the role's identity and what membership grants",
      "request": {
        "method": "GET",
        "path": "/scim/v2/Groups?filter=displayName eq \"scim-dev\""
      },
      "expect": {
        "status": 200,
        "subset": {
          "Resources": [
            {
              "displayName": "scim-dev",
              "schemas": [
                "urn:ietf:params:scim:schemas:core:2.0:Group",
                "urn:straza:params:scim:schemas:extension:2.0:Group"
              ],
              "urn:straza:params:scim:schemas:extension:2.0:Group": {
                "role": "scim-dev",
                "roleKind": "business",
                "plane": "access",
                "description": "Developer access (conformance)"
              }
            }
          ]
        }
      },
      "capture": {
        "gid": "Resources.0.id"
      }
    },
    {
      "note": "the projection is read-only: a write against it answers scimType mutability",
      "request": {
        "method": "PATCH",
        "path": "/scim/v2/Groups/{gid}",
        "body": {
          "schemas": [
            "urn:ietf:params:scim:api:messages:2.0:PatchOp"
          ],
          "Operations": [
            {
              "op": "replace",
              "path": "urn:straza:params:scim:schemas:extension:2.0:Group:role",
              "value": "straza-admin"
            }
          ]
        }
      },
      "expect": {
        "status": 400,
        "subset": {
          "schemas": [
            "urn:ietf:params:scim:api:messages:2.0:Error"
          ],
          "scimType": "mutability"
        }
      }
    }
  ]
}
